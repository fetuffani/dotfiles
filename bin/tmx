#!/usr/bin/env python3
"""tmx: TUI para escolher, renomear, criar e matar sessões do tmux ANTES de entrar nelas.

  tmx              abre o gerenciador
  tmx <args...>    repassa direto ao tmux (ex.: tmx ls, tmx new -s foo)

Com `alias tmux=tmx` (aliases.zsh) basta digitar `tmux`.
Só usa a stdlib (curses), sem dependências.
"""
import curses
import os
import shutil
import subprocess
import sys
import time

# O alias do zsh não afeta subprocessos, então `tmux` aqui é sempre o binário real.
TMUX = shutil.which("tmux")
FMT = "#{session_name}\t#{session_windows}\t#{session_attached}\t#{session_activity}"


def tmux(*args):
    return subprocess.run([TMUX, *args], capture_output=True, text=True)


def list_sessions():
    r = tmux("list-sessions", "-F", FMT)
    if r.returncode != 0:  # sem servidor = sem sessões
        return []
    out = []
    for line in r.stdout.splitlines():
        name, wins, att, act = line.split("\t")
        out.append({"name": name, "windows": int(wins), "attached": int(att), "activity": int(act)})
    return out


def ago(ts):
    d = max(0, int(time.time()) - ts)
    if d < 60:
        return "agora"
    for secs, unit in ((86400, "d"), (3600, "h"), (60, "min")):
        if d >= secs:
            return f"há {d // secs}{unit}"
    return "agora"


def prompt(scr, label, initial=""):
    """Linha de edição no rodapé. Enter confirma, Esc cancela (None)."""
    buf = list(initial)
    curses.curs_set(1)
    try:
        while True:
            h, w = scr.getmaxyx()
            text = label + "".join(buf)
            scr.move(h - 1, 0)
            scr.clrtoeol()
            scr.addnstr(h - 1, 0, text, w - 1, curses.color_pair(2) | curses.A_BOLD)
            scr.move(h - 1, min(len(text), w - 1))
            scr.refresh()
            ch = scr.get_wch()
            if ch in ("\n", "\r") or ch == curses.KEY_ENTER:
                return "".join(buf).strip()
            if ch == "\x1b":
                return None
            if ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                if buf:
                    buf.pop()
            elif isinstance(ch, str) and ch.isprintable():
                buf.append(ch)
    finally:
        curses.curs_set(0)


def confirm(scr, text):
    h, _ = scr.getmaxyx()
    scr.move(h - 1, 0)
    scr.clrtoeol()
    scr.addnstr(h - 1, 0, text + " [s/N] ", scr.getmaxyx()[1] - 1, curses.color_pair(4) | curses.A_BOLD)
    scr.refresh()
    ch = scr.get_wch()
    return isinstance(ch, str) and ch.lower() in ("s", "y")


def draw(scr, sessions, sel, msg):
    scr.erase()
    h, w = scr.getmaxyx()
    scr.addnstr(0, 1, "tmux · sessões", w - 2, curses.color_pair(1) | curses.A_BOLD)
    if not sessions:
        scr.addnstr(2, 2, "Nenhuma sessão ativa. Pressione n para criar uma.", w - 3, curses.color_pair(3))
    name_w = max([len(s["name"]) for s in sessions] + [8])
    for i, s in enumerate(sessions):
        y = 2 + i
        if y >= h - 3:
            break
        dot = "●" if s["attached"] else "○"
        row = f" {i + 1 if i < 9 else ' '} {dot} {s['name']:<{name_w}}  {s['windows']:>2} jan  {ago(s['activity'])}"
        if s["attached"]:
            row += f"  ({s['attached']} anexado)"
        attr = curses.color_pair(5) | curses.A_BOLD if i == sel else curses.color_pair(0)
        scr.addnstr(y, 0, row.ljust(w - 1), w - 1, attr)
    if msg:
        scr.addnstr(h - 2, 1, msg, w - 2, curses.color_pair(4))
    help_ = "↑↓/jk mover  Enter entrar  r renomear  n nova  d matar  q sair"
    scr.addnstr(h - 1, 1, help_, w - 2, curses.color_pair(3))
    scr.refresh()


def ui(scr):
    """Retorna ('attach', nome) ou None."""
    curses.curs_set(0)
    curses.use_default_colors()
    if curses.COLORS >= 256:
        pairs = ((1, 183, -1), (2, 117, -1), (3, 245, -1), (4, 215, -1), (5, 234, 183))
    else:  # terminal só com 8 cores
        pairs = ((1, 5, -1), (2, 6, -1), (3, 7, -1), (4, 3, -1), (5, 0, 5))
    for n, fg, bg in pairs:
        curses.init_pair(n, fg, bg)
    scr.keypad(True)
    sel, msg = 0, ""
    while True:
        sessions = list_sessions()
        sel = max(0, min(sel, len(sessions) - 1))
        draw(scr, sessions, sel, msg)
        msg = ""
        try:
            ch = scr.get_wch()
        except KeyboardInterrupt:
            return None
        cur = sessions[sel]["name"] if sessions else None
        if ch in (curses.KEY_UP, "k"):
            sel = max(0, sel - 1)
        elif ch in (curses.KEY_DOWN, "j"):
            sel = min(len(sessions) - 1, sel + 1)
        elif ch in ("\n", "\r", curses.KEY_ENTER) and cur:
            return ("attach", cur)
        elif isinstance(ch, str) and ch in "123456789" and int(ch) <= len(sessions):
            return ("attach", sessions[int(ch) - 1]["name"])
        elif ch in ("r", curses.KEY_F2) and cur:
            new = prompt(scr, f"renomear '{cur}' para: ", cur)
            if new and new != cur:
                r = tmux("rename-session", "-t", f"={cur}", new)
                msg = r.stderr.strip() if r.returncode else f"renomeada: {cur} → {new}"
        elif ch == "n":
            name = prompt(scr, "nome da nova sessão (vazio = automático): ")
            if name is not None:
                args = ["new-session", "-d", "-P", "-F", "#{session_name}"] + (["-s", name] if name else [])
                r = tmux(*args)
                if r.returncode:
                    msg = r.stderr.strip()
                else:
                    return ("attach", r.stdout.strip())
        elif ch in ("d", "x") and cur:
            if confirm(scr, f"matar sessão '{cur}'?"):
                r = tmux("kill-session", "-t", f"={cur}")
                msg = r.stderr.strip() if r.returncode else f"morta: {cur}"
        elif ch in ("q", "\x1b"):
            return None


def main():
    if not TMUX:
        sys.exit("tmx: tmux não encontrado no PATH")
    if len(sys.argv) > 1 or not (sys.stdin.isatty() and sys.stdout.isatty()):
        os.execv(TMUX, [TMUX, *sys.argv[1:]])
    os.environ.setdefault("ESCDELAY", "25")
    result = curses.wrapper(ui)
    if not result:
        return
    _, name = result
    if os.environ.get("TMUX"):  # já dentro do tmux: troca o cliente em vez de aninhar
        os.execv(TMUX, [TMUX, "switch-client", "-t", f"={name}"])
    os.execv(TMUX, [TMUX, "attach-session", "-t", f"={name}"])


if __name__ == "__main__":
    main()
